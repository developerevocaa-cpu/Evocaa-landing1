# Evocaa Project - Environment Variables Template
# 
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to Git (it's in .gitignore)

# Google Apps Script Web App URL
# Get this from your Google Apps Script deployment
# Format: https://script.google.com/macros/d/{SCRIPT_ID}/userweb
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID_HERE/userweb

# Google Sheet ID (informational only)
# The Apps Script reads the sheet it is bound to (Extensions > Apps Script inside your sheet),
# so this value is not required for the form to work.
# Get this from your Google Sheet URL: docs.google.com/spreadsheets/d/{SHEET_ID}/edit
VITE_GOOGLE_SHEET_ID=YOUR_SHEET_ID_HERE

# Owner email (informational only)
# The Apps Script auto-detects the account running it (or use a Script Property
# "OWNER_EMAIL" to override). Not required by the frontend.
VITE_OWNER_EMAIL=your-email@gmail.com
